<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity"
    android:background="@color/backGround">



    <androidx.gridlayout.widget.GridLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:columnCount="2"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:rowCount="4">

        <Button
            android:id="@+id/button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/bassdrum_label"
            style="@style/buttonStyle"
            android:backgroundTint="@color/orange"
            android:onClick="playBassDrum"/>


        <Button
            android:id="@+id/button2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/hihat1_label"
            style="@style/buttonStyle"
            android:backgroundTint="@color/blue"
            android:onClick="playHiHat1"/>

        <Button
            android:id="@+id/button3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/hihat2_label"
            style="@style/buttonStyle"
            android:backgroundTint="@color/blue"
            android:onClick="playHiHat2"/>

        <Button
            android:id="@+id/button4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/hihat3_label"
            style="@style/buttonStyle"
            android:backgroundTint="@color/blue"
            android:onClick="playHiHat3"/>

        <Button
            android:id="@+id/button5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/hihat4_label"
            style="@style/buttonStyle"
            android:backgroundTint="@color/blue"
            android:onClick="playHiHat4"/>

        <Button
            android:id="@+id/button6"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/perc1_label"
            style="@style/buttonStyle"
            android:backgroundTint="@color/purple"
            android:onClick="playPerc1"/>

        <Button
            android:id="@+id/button7"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/perc2_label"
            style="@style/buttonStyle"
            android:backgroundTint="@color/purple"
            android:onClick="playPerc2"/>

        <Button
            android:id="@+id/button8"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/snaredrum_label"
            style="@style/buttonStyle"
            android:backgroundTint="@color/orange"
            android:onClick="playSnareDrum"/>
    </androidx.gridlayout.widget.GridLayout>
</androidx.constraintlayout.widget.ConstraintLayout>